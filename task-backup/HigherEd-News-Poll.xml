<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>HigherEd review DM command polling (Mon only)</Description>
    <URI>\HigherEd-News-Poll</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
