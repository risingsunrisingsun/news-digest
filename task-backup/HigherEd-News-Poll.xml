      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File "C:\Users\hufs\rasun\news-digest\run.ps1" -Poll</Arguments>
