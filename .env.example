# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  copy .env.example .env

# BotFather 가 발급한 토큰. 앞의 숫자와 콜론까지 전부 포함합니다.
TELEGRAM_BOT_TOKEN=123456789:AAHfiqksKZ8xxxxxxxxxxxxxxxxxxxxxxxx

# 게시할 채널.
#   공개 채널: @my_channel_name
#   비공개 채널: -1001234567890  (@RawDataBot 을 채널에 잠깐 초대하면 확인 가능)
TELEGRAM_CHANNEL_ID=@my_channel_name

# 검토 DM 을 받을 본인의 숫자 사용자 ID.
# 이 ID 에서 온 메시지만 명령으로 처리합니다 (다른 사람이 게시할 수 없도록).
# 모르면: 봇에게 아무 DM 이나 보낸 뒤  .\run.ps1 -WhoAmI  를 실행하면 출력됩니다.
TELEGRAM_ADMIN_ID=412587349
